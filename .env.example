# Environment
ENVIRONMENT=development

# Postgres Database
POSTGRES_DB=protea
POSTGRES_USER=protea_user
POSTGRES_PASSWORD=protea_secure_password
POSTGRES_URL=postgresql://protea_user:protea_secure_password@localhost:5432/protea

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secure_password

# Redis Database
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secure_password

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000

# Authentication
KEYCLOAK_URL=http://localhost:8080
JWT_SECRET=super_secret_jwt_key_for_local_development_only_12345
JWT_ALGORITHM=HS256
