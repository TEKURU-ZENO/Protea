{
  "name": "protea",
  "version": "1.0.0",
  "packageManager": "npm@10.8.2",
  "description": "PROTEA: An AI-Native Computational Interactomics Platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.10.5"
  },
  "dependencies": {
    "next": "15.5.20"
  }
}
